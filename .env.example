# Copie para .env e preencha:  cp .env.example .env

# Login do painel
APP_USER=admin
APP_PASSWORD=troque-por-uma-senha-forte

# Domínio apontado para a VPS (usado pelo Caddy para gerar o HTTPS)
DOMAIN=vendas.seudominio.com.br

# Porta local do app na VPS (o Caddy/nginx encaminha para ela)
APP_PORT=3000

# Opcionais
# SESSION_DAYS=30          # dias que o login fica salvo
# COOKIE_SECURE=true       # force cookie só-HTTPS (o padrão detecta sozinho)
# SESSION_SECRET=          # se vazio, é gerado e salvo em data/.session-secret
