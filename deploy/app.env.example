# Segredos do app em produção: /srv/apps/dash/app.env (fica só no servidor, nunca no git).
#   sudoedit /srv/apps/dash/app.env && cd /srv/apps/dash && docker compose -p dash up -d

# Login do painel
APP_USER=admin
APP_PASSWORD=troque-por-uma-senha-forte

# Opcionais
# SESSION_DAYS=30          # dias que o login fica salvo
# SESSION_SECRET=          # se vazio, é gerado e salvo em data/.session-secret
